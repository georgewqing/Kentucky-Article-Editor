{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Win: Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/win",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--sourcemap"],
      "windows": {
        "runtimeExecutable": "npm.cmd"
      },
      "env": {
        "REMOTE_DEBUGGING_PORT": "9222"
      },
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "group": "Kentucky",
        "order": 2
      }
    },
    {
      "name": "Win: Debug Renderer Process",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/win/src/renderer",
      "timeout": 60000,
      "presentation": {
        "hidden": true,
        "group": "Kentucky",
        "order": 3
      }
    },
    {
      "name": "Win: Run Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/win",
      "presentation": {
        "group": "Kentucky",
        "order": 4
      }
    },
    {
      "name": "Android: Vite Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/android",
      "presentation": {
        "group": "Kentucky",
        "order": 5
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Win: Debug Main Process", "Win: Debug Renderer Process"],
      "stopAll": true,
      "presentation": {
        "group": "Kentucky",
        "order": 1
      }
    }
  ]
}
