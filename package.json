{
  "name": "kentucky",
  "version": "0.3.2",
  "description": "KENTUCKY - local Markdown writing + freeform mind maps + AI writing agent",
  "main": "./out/main/index.js",
  "author": "leyang chen",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "ensure-ffmpeg": "node scripts/ensure-ffmpeg.js",
    "dist": "node scripts/ensure-ffmpeg.js && npm run build && electron-builder --win dir && node scripts/rename-unpacked.js",
    "dist:dir": "node scripts/ensure-ffmpeg.js && npm run build && electron-builder --win dir && node scripts/rename-unpacked.js",
    "dist:portable": "node scripts/ensure-ffmpeg.js && npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.ccfox12.kentucky",
    "productName": "KENTUCKY",
    "copyright": "Copyright (c) leyang chen",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "resources/ai-skills",
        "to": "ai-skills"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "description": "Markdown Document",
          "mimeType": "text/markdown",
          "role": "Editor"
        }
      ],
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@xyflow/react": "^12.11.2",
    "html-to-image": "^1.11.13",
    "i18next": "^25.3.2",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^5.4.296",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/js-yaml": "^4.0.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
